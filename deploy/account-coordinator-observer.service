[Unit]
Description=Shared account coordinator (observation only; financial writes disabled)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=yuduo
Group=yuduo
ExecStart=/home/yuduo/.local/share/account-coordinator/current/account-coordinator observe --config /home/yuduo/.config/account-coordinator/config.json --state /home/yuduo/.local/state/account-coordinator
Restart=on-failure
RestartSec=10
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateUsers=no
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/yuduo/.local/state/account-coordinator /home/yuduo/.local/state/autowheel
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
LimitNOFILE=256
MemoryMax=384M
TasksMax=48
CPUQuota=25%

[Install]
WantedBy=multi-user.target
