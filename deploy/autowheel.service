[Unit]
Description=AutoWheel Robinhood wheel (native readiness-gated activation)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=yuduo
Group=yuduo
ExecStart=/home/yuduo/.local/share/autowheel/current/autowheel run --config /home/yuduo/.config/autowheel/config.json --state /home/yuduo/.local/state/autowheel --listen 127.0.0.1:9841 --live-capable
Restart=on-failure
RestartSec=10
TimeoutStopSec=35
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateUsers=no
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/yuduo/.local/state/autowheel
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
LimitNOFILE=1024
MemoryMax=256M
TasksMax=32
CPUQuota=25%

[Install]
WantedBy=multi-user.target
